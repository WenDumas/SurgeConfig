```yaml
# ============================================================
# FLClash / Mihomo Android 优化配置
# 策略组：按照你现有的策略组重新整理
# ============================================================


# ============================================================
# 基础设置
# ============================================================

mixed-port: 7890
allow-lan: true
bind-address: "*"

mode: rule
log-level: info

ipv6: false

external-controller: 127.0.0.1:9090

unified-delay: false
tcp-concurrent: true


# ============================================================
# DNS
# ============================================================

dns:
  enable: true

  # FLClash + TUN 建议使用 fake-ip
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  ipv6: false
  respect-ipv6: false

  # 本机 DNS 服务
  listen: 0.0.0.0:1053

  # 国内 DNS
  nameserver:
    - 223.5.5.5
    - 119.29.29.29

  # 国外备用 DNS
  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  fallback-filter:
    geoip: true
    geoip-code: CN

    domain:
      - "+.google.com"
      - "+.googleapis.com"
      - "+.youtube.com"
      - "+.facebook.com"
      - "+.twitter.com"
      - "+.x.com"
      - "+.telegram.org"
      - "+.t.me"

  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.arpa"
    - "localhost"
    - "localhost.*"
    - "+.push.apple.com"
    - "+.market.xiaomi.com"
    - "+.msftncsi.com"
    - "www.msftconnecttest.com"
    - "time.*.com"
    - "ntp.*.com"

  # DNS 缓存
  cache-algorithm: arc


# ============================================================
# 本地 Hosts
# ============================================================

hosts: {}


# ============================================================
# 节点订阅
# ============================================================

proxy-providers:

  my_subscription:
    type: http

    # ↓↓↓ 这里填写你的真实订阅地址 ↓↓↓
    url: "你的机场订阅链接"

    path: ./proxies/my_subscription.yaml

    interval: 3600

    health-check:
      enable: true

      # 使用 Cloudflare 做节点延迟测试
      url: "https://cp.cloudflare.com/"

      interval: 600
      timeout: 5000

      # 没使用的节点不主动测试，降低 Android 手机负载
      lazy: true

      # Cloudflare 正常返回 204
      expected-status: 204


# ============================================================
# 手动节点
# ============================================================

proxies: []


# ============================================================
# 策略组
# ============================================================

proxy-groups:

  # ----------------------------------------------------------
  # 🔰 节点选择
  # ----------------------------------------------------------
  - name: "🔰 节点选择"
    type: select

    proxies:
      - "♻️ 自动选择"
      - "🇸🇬 新加坡"
      - "🇸🇬 新加坡自动选择"
      - "🇺🇸 美国"
      - "🇺🇸 美国自动选择"
      - "🌏 其它地区"
      - "📦 全部节点"

    use:
      - my_subscription


  # ----------------------------------------------------------
  # ♻️ 自动选择
  # ----------------------------------------------------------
  - name: "♻️ 自动选择"
    type: url-test

    use:
      - my_subscription

    url: "https://cp.cloudflare.com/"

    interval: 300
    tolerance: 10
    timeout: 5000
    lazy: true

    # 排除订阅信息节点
    exclude-filter: "(?i)GB|Traffic|Expire|Premium|频道|订阅|ISP|流量|到期|重置"


  # ----------------------------------------------------------
  # 🌍 国外媒体
  # ----------------------------------------------------------
  - name: "🌍 国外媒体"
    type: select

    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "🇸🇬 新加坡"
      - "🇸🇬 新加坡自动选择"
      - "🇺🇸 美国"
      - "🇺🇸 美国自动选择"
      - "🌏 其它地区"
      - "📦 全部节点"
      - "🎯 全球直连"


  # ----------------------------------------------------------
  # Ⓜ️ 微软服务
  # ----------------------------------------------------------
  - name: "Ⓜ️ 微软服务"
    type: select

    proxies:
      - "🎯 全球直连"
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "🇸🇬 新加坡自动选择"
      - "🇺🇸 美国自动选择"


  # ----------------------------------------------------------
  # 📲 电报信息
  # ----------------------------------------------------------
  - name: "📲 电报信息"
    type: select

    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "🇸🇬 新加坡"
      - "🇸🇬 新加坡自动选择"
      - "🇺🇸 美国"
      - "🇺🇸 美国自动选择"
      - "🌏 其它地区"
      - "🎯 全球直连"


  # ----------------------------------------------------------
  # 🍎 苹果服务
  # ----------------------------------------------------------
  - name: "🍎 苹果服务"
    type: select

    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "🇸🇬 新加坡"
      - "🇺🇸 美国"
      - "🌏 其它地区"
      - "🎯 全球直连"


  # ----------------------------------------------------------
  # 🐟 漏网之鱼
  # ----------------------------------------------------------
  - name: "🐟 漏网之鱼"
    type: select

    proxies:
      - "🔰 节点选择"
      - "♻️ 自动选择"
      - "🇸🇬 新加坡"
      - "🇺🇸 美国"
      - "🌏 其它地区"
      - "📦 全部节点"
      - "🎯 全球直连"


  # ----------------------------------------------------------
  # 🎯 全球直连
  # ----------------------------------------------------------
  - name: "🎯 全球直连"
    type: select

    proxies:
      - DIRECT


  # ----------------------------------------------------------
  # 🛑 全球拦截
  # ----------------------------------------------------------
  - name: "🛑 全球拦截"
    type: select

    proxies:
      - REJECT


  # ==========================================================
  # 地区分组
  # ==========================================================

  # ----------------------------------------------------------
  # 🇸🇬 新加坡
  # ----------------------------------------------------------
  - name: "🇸🇬 新加坡"
    type: select

    use:
      - my_subscription

    filter: "(?i)新|sg|singapore|🇸🇬|狮城"

    exclude-filter: "(?i)GB|Traffic|Expire|Premium|频道|订阅|ISP|流量|到期|重置"


  # ----------------------------------------------------------
  # 🇸🇬 新加坡自动选择
  # ----------------------------------------------------------
  - name: "🇸🇬 新加坡自动选择"
    type: url-test

    use:
      - my_subscription

    filter: "(?i)新|sg|singapore|🇸🇬|狮城"

    exclude-filter: "(?i)GB|Traffic|Expire|Premium|频道|订阅|ISP|流量|到期|重置"

    url: "https://cp.cloudflare.com/"

    interval: 300
    tolerance: 10
    timeout: 5000
    lazy: true


  # ----------------------------------------------------------
  # 🇺🇸 美国
  # ----------------------------------------------------------
  - name: "🇺🇸 美国"
    type: select

    use:
      - my_subscription

    filter: "(?i)美|us|usa|unitedstates|united states|america|🇺🇸"

    exclude-filter: "(?i)GB|Traffic|Expire|Premium|频道|订阅|ISP|流量|到期|重置"


  # ----------------------------------------------------------
  # 🇺🇸 美国自动选择
  # ----------------------------------------------------------
  - name: "🇺🇸 美国自动选择"
    type: url-test

    use:
      - my_subscription

    filter: "(?i)美|us|usa|unitedstates|united states|america|🇺🇸"

    exclude-filter: "(?i)GB|Traffic|Expire|Premium|频道|订阅|ISP|流量|到期|重置"

    url: "https://cp.cloudflare.com/"

    interval: 300
    tolerance: 10
    timeout: 5000
    lazy: true


  # ----------------------------------------------------------
  # 🌏 其它地区
  # ----------------------------------------------------------
  - name: "🌏 其它地区"
    type: select

    use:
      - my_subscription

    filter: "(?i)^(?!.*(?:🇭🇰|🇯🇵|🇺🇸|🇸🇬|🇨🇳|港|hk|hongkong|香港|台|tw|taiwan|台湾|日|jp|japan|日本|新|sg|singapore|狮城|美|us|usa|unitedstates|america)).*"

    exclude-filter: "(?i)GB|Traffic|Expire|Premium|频道|订阅|ISP|流量|到期|重置"


  # ----------------------------------------------------------
  # 📦 全部节点
  # ----------------------------------------------------------
  - name: "📦 全部节点"
    type: select

    use:
      - my_subscription

    exclude-filter: "(?i)GB|Traffic|Expire|Premium|频道|订阅|ISP|流量|到期|重置"


# ============================================================
# 路由规则
# ============================================================

rules:

  # ----------------------------------------------------------
  # 本机 / 局域网
  # ----------------------------------------------------------

  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve


  # ----------------------------------------------------------
  # 私有 / 局域网域名
  # ----------------------------------------------------------

  - GEOSITE,private,DIRECT


  # ----------------------------------------------------------
  # 微信
  # ----------------------------------------------------------

  - GEOSITE,wechat,DIRECT


  # ----------------------------------------------------------
  # 微软
  # ----------------------------------------------------------

  - GEOSITE,microsoft,Ⓜ️ 微软服务


  # ----------------------------------------------------------
  # Apple
  # ----------------------------------------------------------

  - GEOSITE,apple,🍎 苹果服务


  # ----------------------------------------------------------
  # Telegram
  # ----------------------------------------------------------

  - GEOSITE,telegram,📲 电报信息
  - GEOIP,telegram,📲 电报信息,no-resolve


  # ----------------------------------------------------------
  # Google
  # ----------------------------------------------------------

  - GEOSITE,google,🌍 国外媒体
  - GEOIP,google,🌍 国外媒体,no-resolve


  # ----------------------------------------------------------
  # YouTube
  # ----------------------------------------------------------

  - GEOSITE,youtube,🌍 国外媒体


  # ----------------------------------------------------------
  # Netflix
  # ----------------------------------------------------------

  - GEOSITE,netflix,🌍 国外媒体
  - GEOIP,netflix,🌍 国外媒体,no-resolve


  # ----------------------------------------------------------
  # Spotify
  # ----------------------------------------------------------

  - GEOSITE,spotify,🌍 国外媒体


  # ----------------------------------------------------------
  # Twitter / X
  # ----------------------------------------------------------

  - GEOSITE,twitter,🌍 国外媒体
  - GEOIP,twitter,🌍 国外媒体,no-resolve


  # ----------------------------------------------------------
  # GitHub
  # ----------------------------------------------------------

  - GEOSITE,github,🌍 国外媒体


  # ----------------------------------------------------------
  # Pixiv
  # ----------------------------------------------------------

  - GEOSITE,pixiv,🌍 国外媒体


  # ----------------------------------------------------------
  # Bilibili
  # ----------------------------------------------------------

  - GEOSITE,bilibili,🎯 全球直连


  # ----------------------------------------------------------
  # 中国大陆域名
  # ----------------------------------------------------------

  - GEOSITE,cn,🎯 全球直连


  # ----------------------------------------------------------
  # 中国大陆 IP
  # ----------------------------------------------------------

  - GEOIP,CN,🎯 全球直连,no-resolve


  # ----------------------------------------------------------
  # 其它海外域名
  # ----------------------------------------------------------

  - GEOSITE,geolocation-!cn,🐟 漏网之鱼


  # ----------------------------------------------------------
  # 最终兜底
  # ----------------------------------------------------------

  - MATCH,🐟 漏网之鱼
```
