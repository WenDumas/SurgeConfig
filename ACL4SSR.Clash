# ================= 遠程訂閱配置 =================
proxy-providers:
  MySub:
    type: http
    url: "https://misub.88666.de5.net/profiles/42c60cca-6b01-4f8f-b248-41cf5f49c8c4"
    interval: 3600
    path: ./providers/mysub.yaml
    health-check:
      enable: true
      interval: 600
      url: http://www.gstatic.com/generate_204

# ================= 規則集配置 (高效 .mrs 格式) =================
rule-providers:
  private:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/private.mrs
    path: ./ruleset/private.mrs
    behavior: domain
    interval: 86400
    format: mrs
    type: http
  cn_domain:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.mrs
    path: ./ruleset/cn_domain.mrs
    behavior: domain
    interval: 86400
    format: mrs
    type: http
  telegram_domain:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/telegram.mrs
    path: ./ruleset/telegram_domain.mrs
    behavior: domain
    interval: 86400
    format: mrs
    type: http
  google_domain:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/google.mrs
    path: ./ruleset/google_domain.mrs
    behavior: domain
    interval: 86400
    format: mrs
    type: http
  openai_domain:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/openai.mrs
    path: ./ruleset/openai_domain.mrs
    behavior: domain
    interval: 86400
    format: mrs
    type: http
  claude_domain:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/anthropic.mrs
    path: ./ruleset/claude_domain.mrs
    behavior: domain
    interval: 86400
    format: mrs
    type: http
  geolocation-!cn:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/geolocation-!cn.mrs
    path: ./ruleset/geolocation-!cn.mrs
    behavior: domain
    interval: 86400
    format: mrs
    type: http
  cn_ip:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.mrs
    path: ./ruleset/cn_ip.mrs
    behavior: ipcidr
    interval: 86400
    format: mrs
    type: http
  telegram_ip:
    url: https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/telegram.mrs
    path: ./ruleset/telegram_ip.mrs
    behavior: ipcidr
    interval: 86400
    format: mrs
    type: http

# ================= 策略組配置 (SURGE 邏輯優化) =================
proxy-groups:
  - name: PROXY
    type: select
    # 這裡同時使用 proxies 和 use，能實現在 UI 面板最上方顯示子策略組，下方平鋪所有節點供手動切換
    proxies:
      - AUTO
      - HK AUTO
      - SG AUTO
      - JP AUTO
      - US AUTO
    use:
      - MySub
    exclude-filter: (?i)GB|Traffic|Expire|Premium|頻道|訂閱|ISP|流量|到期|重置

  - name: AUTO
    type: url-test
    use:
      - MySub
    exclude-filter: (?i)GB|Traffic|Expire|Premium|頻道|訂閱|ISP|流量|到期|重置
    interval: 300
    tolerance: 50

  - name: AIGC
    type: select
    proxies:
      - SG AUTO
      - JP AUTO
      - US AUTO

  - name: Telegram
    type: select
    proxies:
      - HK AUTO
      - SG AUTO
      - JP AUTO
      - US AUTO

  - name: Google
    type: select
    proxies:
      - HK AUTO
      - SG AUTO
      - JP AUTO
      - US AUTO

  - name: HK AUTO
    type: url-test
    use:
      - MySub
    filter: (?i)香港|Hong Kong|HK|🇭🇰
    exclude-filter: (?i)GB|Traffic|Expire|Premium|頻道|訂閱|ISP|流量|到期|重置
    interval: 300
    tolerance: 50

  - name: SG AUTO
    type: url-test
    use:
      - MySub
    filter: (?i)新加坡|Singapore|🇸🇬
    exclude-filter: (?i)GB|Traffic|Expire|Premium|頻道|訂閱|ISP|流量|到期|重置
    interval: 300
    tolerance: 50

  - name: JP AUTO
    type: url-test
    use:
      - MySub
    filter: (?i)日本|Japan|🇯🇵
    exclude-filter: (?i)GB|Traffic|Expire|Premium|頻道|訂閱|ISP|流量|到期|重置
    interval: 300
    tolerance: 50

  - name: US AUTO
    type: url-test
    use:
      - MySub
    filter: (?i)美國|USA|🇺🇸
    exclude-filter: (?i)GB|Traffic|Expire|Premium|頻道|訂閱|ISP|流量|到期|重置
    interval: 300
    tolerance: 50

  - name: GLOBAL
    type: select
    proxies:
      - PROXY
      - AUTO
      - AIGC
      - Telegram
      - Google
    use:
      - MySub

# ================= 路由規則 =================
rules:
  - RULE-SET,private,DIRECT
  - RULE-SET,openai_domain,AIGC
  - RULE-SET,claude_domain,AIGC
  - RULE-SET,telegram_domain,Telegram
  - RULE-SET,telegram_ip,Telegram,no-resolve
  - RULE-SET,google_domain,Google
  - RULE-SET,geolocation-!cn,PROXY
  - RULE-SET,cn_domain,DIRECT
  - RULE-SET,cn_ip,DIRECT,no-resolve
  - MATCH,PROXY
