# ==========================================
# FLClash / Mihomo (Clash Meta) 修正版配置
# ==========================================

p: &p
  type: http
  interval: 3600
  health-check:
    enable: true
    url: "https://www.gstatic.com/generate_204"
    interval: 300

pr: &pr
  type: select
  proxies:
    - PROXY
    - AUTO
    - HK AUTO
    - SG AUTO
    - JP AUTO
    - US AUTO
    - 全部节点

# ================= 訂閱源配置 =================
proxy-providers:
  provider1:
    <<: *p
    url: "你的訂閱鏈接"  # 提醒：請確保替換為真實的機場訂閱 URL
    path: ./proxies/provider1.yaml

# ================= 策略組配置 =================
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - AUTO
      - HK AUTO
      - SG AUTO
      - JP AUTO
      - US AUTO
      - 全部节点

  - name: AIGC
    <<: *pr
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/ChatGPT.png"

  - name: Telegram
    <<: *pr
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Telegram.png"

  - name: Google
    <<: *pr
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Google_Search.png"

  - name: GLOBAL
    type: select
    proxies:
      - PROXY
      - AUTO
      - AIGC
      - Telegram
      - Google
      - HK AUTO
      - SG AUTO
      - JP AUTO
      - US AUTO
      - 全部节点

  - name: HK AUTO
    type: url-test
    use:
      - provider1
    filter: "(?i)香港|Hong Kong|HK|🇭🇰"
    interval: 300
    tolerance: 50
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/HK.png"

  - name: SG AUTO
    type: url-test
    use:
      - provider1
    filter: "(?i)新加坡|Singapore|SG|🇸🇬"
    interval: 300
    tolerance: 50
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/SG.png"

  - name: JP AUTO
    type: url-test
    use:
      - provider1
    filter: "(?i)日本|Japan|JP|🇯🇵"
    interval: 300
    tolerance: 50
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/JP.png"

  - name: US AUTO
    type: url-test
    use:
      - provider1
    filter: "(?i)美國|美国|USA|United States|🇺🇸"
    interval: 300
    tolerance: 50
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/US.png"

  - name: AUTO
    type: url-test
    use:
      - provider1
    tolerance: 50
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Auto.png"

  - name: 全部节点
    type: select
    use:
      - provider1
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Global.png"

# ================= 路由規則 =================
rules:
  - RULE-SET,private,DIRECT
  - RULE-SET,openai_domain,AIGC
  - RULE-SET,claude_domain,AIGC
  - RULE-SET,telegram_domain,Telegram
  - RULE-SET,telegram_ip,Telegram,no-resolve
  - RULE-SET,google_domain,Google
  - RULE-SET,geolocation-!cn,PROXY
  - RULE-SET,cn_domain,DIRECT
  - RULE-SET,cn_ip,DIRECT,no-resolve
  - MATCH,PROXY

# ================= 規則集配置 (.mrs 格式) =================
rule-anchor:
  mrs_base: &mrs_base
    type: http
    interval: 86400
    format: mrs

rule-providers:
  private:
    <<: *mrs_base
    path: ./rules/private.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/private.mrs"

  cn_domain:
    <<: *mrs_base
    path: ./rules/cn_domain.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.mrs"

  telegram_domain:
    <<: *mrs_base
    path: ./rules/telegram_domain.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/telegram.mrs"

  google_domain:
    <<: *mrs_base
    path: ./rules/google_domain.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/google.mrs"

  openai_domain:
    <<: *mrs_base
    path: ./rules/openai_domain.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/openai.mrs"

  claude_domain:
    <<: *mrs_base
    path: ./rules/claude_domain.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/anthropic.mrs"

  "geolocation-!cn":
    <<: *mrs_base
    path: ./rules/geolocation-!cn.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/geolocation-!cn.mrs"

  cn_ip:
    <<: *mrs_base
    path: ./rules/cn_ip.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.mrs"

  telegram_ip:
    <<: *mrs_base
    path: ./rules/telegram_ip.mrs
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/telegram.mrs"
