######### 錨點與全局設置 #######
p: &p {type: http, interval: 3600, health-check: {enable: true, url: "https://www.gstatic.com/generate_204", interval: 300}}
# 策略組公共錨點：採用 Clash 參考文件的寫法
pr: &pr {type: select, proxies: [PROXY, AUTO, HK AUTO, SG AUTO, JP AUTO, US AUTO]}
######### 錨點 end #######

ipv6: true
allow-lan: true
mixed-port: 7890
external-controller: 127.0.0.1:9090
profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 28.0.0.1/8
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "stun.*"
    - "+.stun.*.*"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query

# 節點訂閱源
proxy-providers:
  provider1:
    <<: *p
    url: "你的訂閱鏈接1填這裡"
    path: ./proxies/provider1.yaml
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300

proxies:
  - name: "直連"
    type: direct
    udp: true

# ================= 策略組配置 =================
proxy-groups:
  # 主代理入口
  - {name: PROXY, type: select, proxies: [AUTO, HK AUTO, SG AUTO, JP AUTO, US AUTO, 直連], use: [provider1]}

  # AI / AIGC
  - {name: AIGC, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/ChatGPT.png"}

  # Telegram
  - {name: Telegram, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Telegram.png"}

  # Google
  - {name: Google, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Google_Search.png"}

  # 全局入口
  - {name: GLOBAL, type: select, proxies: [PROXY, AUTO, AIGC, Telegram, Google, HK AUTO, SG AUTO, JP AUTO, US AUTO, 直連], use: [provider1]}

  # 地區分組：採用 Clash 參考配置的 include-all + use + filter 格式
  - {name: HK AUTO, type: url-test, include-all: true, use: [provider1], filter: "(?i)香港|Hong Kong|HK|🇭🇰", interval: 300, tolerance: 50, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/HK.png"}
  - {name: SG AUTO, type: url-test, include-all: true, use: [provider1], filter: "(?i)新加坡|Singapore|SG|🇸🇬", interval: 300, tolerance: 50, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/SG.png"}
  - {name: JP AUTO, type: url-test, include-all: true, use: [provider1], filter: "(?i)日本|Japan|JP|🇯🇵", interval: 300, tolerance: 50, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/JP.png"}
  - {name: US AUTO, type: url-test, include-all: true, use: [provider1], filter: "(?i)美國|美国|USA|US|United States|🇺🇸", interval: 300, tolerance: 50, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/US.png"}
  - {name: AUTO, type: url-test, include-all: true, use: [provider1], tolerance: 50, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Auto.png"}
  - {name: 全部节点, type: select, include-all: true, use: [provider1], icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Global.png"}

# ================= 路由規則 =================
rules:
  - RULE-SET,private,DIRECT
  - RULE-SET,openai_domain,AIGC
  - RULE-SET,claude_domain,AIGC
  - RULE-SET,telegram_domain,Telegram
  - RULE-SET,telegram_ip,Telegram,no-resolve
  - RULE-SET,google_domain,Google
  - RULE-SET,geolocation-!cn,PROXY
  - RULE-SET,cn_domain,DIRECT
  - RULE-SET,cn_ip,DIRECT,no-resolve
  - MATCH,PROXY

# ================= 規則集配置 (.mrs 格式) =================
rule-anchor:
  ip: &ip {type: http, interval: 86400, behavior: ipcidr, format: mrs}
  domain: &domain {type: http, interval: 86400, behavior: domain, format: mrs}

rule-providers:
  private:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/private.mrs"
  cn_domain:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.mrs"
  telegram_domain:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/telegram.mrs"
  google_domain:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/google.mrs"
  openai_domain:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/openai.mrs"
  claude_domain:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/anthropic.mrs"
  geolocation-!cn:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/geolocation-!cn.mrs"
  cn_ip:
    <<: *ip
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.mrs"
  telegram_ip:
    <<: *ip
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/telegram.mrs"
